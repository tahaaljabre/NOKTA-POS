{
  "appId": "com.nokta.pos",
  "appName": "NOKTA POS",
  "webDir": "public",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "Sqlite": {
      "iosDatabaseLocation": "Library/Database",
      "androidDatabaseLocation": "databases"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
