{
  "name": "nokta-pos",
  "version": "1.0.0",
  "description": "Flexible Point of Sale platform for Android tablets and desktop",
  "author": "NOKTA POS",
  "main": "electron.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder --win nsis",
    "test": "node tests/run.cjs",
    "check": "node scripts/check-project.cjs",
    "android:sync": "node scripts/capacitor-env.js ./node_modules/@capacitor/cli/bin/capacitor sync android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "cors": "^2.8.6",
    "escpos": "3.0.0-alpha.6",
    "escpos-network": "3.0.0-alpha.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "optionalDependencies": {
    "escpos-bluetooth": "3.0.0-alpha.2",
    "escpos-usb": "3.0.0-alpha.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nokta.pos.desktop",
    "productName": "NOKTA POS",
    "asar": true,
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "electron.js",
      "preload.js",
      "server.js",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build-icons/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
